  "info": {
    "title": "Dhan Trader Backend API",
    "description": "High-performance algorithmic trading and price alert engine powered by Dhan HQ API v2 and NestJS (TypeScript).",
    "version": "2.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "System",
      "description": "Service status & health"
    },
    {
      "name": "Auth",
      "description": "Dhan access token inspection, validation and renewal"
    },
    {
      "name": "Alerts",
      "description": "Price alerts monitoring on NSE Indices (No static IP needed)"
    },
    {
      "name": "Orders",
      "description": "Order placement, book inspection, and cancellation"
    },
    {
      "name": "Instruments",
      "description": "NSE scrip master search and indices lookup"
    },
    {
      "name": "Telegram",
      "description": "Telegram bot alerts and live connection configuration"
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "UpdateTelegramDto": {
        "type": "object",
        "properties": {
          "botToken": {
            "type": "string",
            "description": "Telegram Bot Token",
            "example": "123456789:ABCDefgh..."
          },
          "chatId": {
            "type": "string",
            "description": "Telegram Chat ID",
            "example": "8953936469"
          }
        }
      },
      "UpdateTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Dhan JWT Access Token",
            "example": "eyJhbGciOiJIUzUxMiJ9..."
          },
          "clientId": {
            "type": "string",
            "description": "Dhan Client ID",
            "example": "1106885516"
          }
        },
        "required": [
          "token"
        ]
      },
      "ConditionalOrderDto": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "Trading symbol to order upon alert trigger",
            "example": "NIFTY 25500 CE"
          },
          "securityId": {
            "type": "string",
            "description": "Dhan security ID (e.g. 45021). If omitted, system attempts resolution from symbol.",
            "example": "45021"
          },
          "exchangeSegment": {
            "type": "string",
            "description": "Exchange segment",
            "example": "NSE_FNO",
            "default": "NSE_FNO"
          },
          "transactionType": {
            "type": "string",
            "description": "Order transaction side",
            "enum": [
              "BUY",
              "SELL"
            ],
            "example": "BUY"
          },
          "orderType": {
            "type": "string",
            "description": "Order type",
            "enum": [
              "MARKET",
              "LIMIT",
              "SL",
              "SL-M"
            ],
            "default": "MARKET"
          },
          "productType": {
            "type": "string",
            "description": "Product type",
            "enum": [
              "INTRADAY",
              "CNC",
              "MARGIN"
            ],
            "default": "INTRADAY"
          },
          "quantity": {
            "type": "number",
            "description": "Order quantity",
            "example": 50
          },
          "price": {
            "type": "number",
            "description": "Limit price for LIMIT orders",
            "example": 130
          },
          "triggerPrice": {
            "type": "number",
            "description": "Trigger price for SL orders",
            "example": 0
          },
          "validity": {
            "type": "string",
            "description": "Order validity",
            "enum": [
              "DAY",
              "IOC"
            ],
            "default": "DAY"
          }
        },
        "required": [
          "symbol",
          "transactionType",
          "quantity"
        ]
      },
      "CreateAlertDto": {
        "type": "object",
        "properties": {
          "instrument": {
            "type": "string",
            "description": "Instrument symbol or Index name",
            "example": "NIFTY 50"
          },
          "targetPrice": {
            "type": "number",
            "description": "Target price level to alert on",
            "example": 24950
          },
          "operator": {
            "type": "string",
            "description": "Trigger condition operator",
            "enum": [
              "GREATER_THAN_OR_EQUAL",
              "LESS_THAN_OR_EQUAL",
              "CROSSING_UP",
              "CROSSING_DOWN"
            ],
            "default": "GREATER_THAN_OR_EQUAL"
          },
          "remarks": {
            "type": "string",
            "description": "Remarks or user note",
            "example": "Breakout above resistance"
          },
          "securityId": {
            "type": "string",
            "description": "Dhan security ID",
            "example": "13"
          },
          "exchangeSegment": {
            "type": "string",
            "description": "Exchange segment",
            "example": "IDX_I"
          },
          "conditionalOrder": {
            "description": "Single conditional order details to place upon trigger",
            "allOf": [
              {
                "$ref": "#/components/schemas/ConditionalOrderDto"
              }
            ]
          },
          "conditionalOrders": {
            "description": "Array of conditional orders to place upon trigger",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConditionalOrderDto"
            }
          }
        },
        "required": [
          "instrument",
          "targetPrice"
        ]
      },
      "CreateConditionalAlertDto": {
        "type": "object",
        "properties": {
          "instrument": {
            "type": "string",
            "description": "Underlying instrument symbol or index name to monitor",
            "example": "NIFTY 50"
          },
          "targetPrice": {
            "type": "number",
            "description": "Target price level that triggers the alert and conditional order",
            "example": 25500
          },
          "operator": {
            "type": "string",
            "description": "Trigger condition operator",
            "enum": [
              "GREATER_THAN_OR_EQUAL",
              "LESS_THAN_OR_EQUAL",
              "CROSSING_UP",
              "CROSSING_DOWN"
            ],
            "default": "GREATER_THAN_OR_EQUAL"
          },
          "securityId": {
            "type": "string",
            "description": "Dhan security ID of the underlying instrument",
            "example": "13"
          },
          "exchangeSegment": {
            "type": "string",
            "description": "Exchange segment of the underlying instrument",
            "example": "IDX_I",
            "default": "IDX_I"
          },
          "remarks": {
            "type": "string",
            "description": "User remarks or strategy note",
            "example": "Buy Call option when Nifty breaks 25500 resistance"
          },
          "conditionalOrder": {
            "description": "Single conditional order details to place upon trigger",
            "allOf": [
              {
                "$ref": "#/components/schemas/ConditionalOrderDto"
              }
            ]
          },
          "conditionalOrders": {
            "description": "Array of conditional orders to place upon trigger",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConditionalOrderDto"
            }
          },
          "executeViaDhanApi": {
            "type": "boolean",
            "description": "Attempt registration with Dhan HQ API v2 (/alerts/orders)",
            "default": true
          },
          "autoExecuteOnTrigger": {
            "type": "boolean",
            "description": "Auto-execute the order via in-memory marketfeed engine upon trigger (No static IP required)",
            "default": true
          },
          "frequency": {
            "type": "string",
            "description": "Alert frequency mode",
            "enum": [
              "ONCE",
              "IMMEDIATELY"
            ],
            "default": "ONCE"
          },
          "comparisonType": {
            "type": "string",
            "description": "Comparison type",
            "enum": [
              "PRICE",
              "TECHNICAL_WITH_VALUE"
            ],
            "default": "PRICE"
          }
        },
        "required": [
          "instrument",
          "targetPrice"
        ]
      },
      "UpdateAlertDto": {
        "type": "object",
        "properties": {
          "targetPrice": {
            "type": "number",
            "description": "Target price level",
            "example": 25000
          },
          "operator": {
            "type": "string",
            "description": "Trigger condition operator",
            "example": "GREATER_THAN_OR_EQUAL"
          },
          "remarks": {
            "type": "string",
            "description": "Remarks",
            "example": "Updated level"
          },
          "status": {
            "type": "string",
            "description": "Alert status",
            "enum": [
              "ACTIVE",
              "TRIGGERED",
              "CANCELLED"
            ]
          }
        }
      },
      "GetOptionContractsDto": {
        "type": "object",
        "properties": {
          "instrument": {
            "type": "string",
            "description": "Underlying instrument name or symbol (e.g. NIFTY 50, NIFTY, BANKNIFTY, SENSEX)",
            "example": "NIFTY 50"
          },
          "price": {
            "type": "number",
            "description": "Reference price to calculate ATM, ITM, and OTM strikes (e.g. 25500). If omitted, live LTP is used.",
            "example": 25500
          },
          "expiry": {
            "type": "string",
            "description": "Target expiry date in YYYY-MM-DD or DD-MM-YYYY format (e.g. 2026-11-05). If omitted, nearest expiry is used.",
            "example": "2026-11-05"
          }
        },
        "required": [
          "instrument"
        ]
      },
      "PlaceOrderDto": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "Trading symbol",
            "example": "NIFTY 24500 CE"
          },
          "securityId": {
            "type": "string",
            "description": "Dhan security ID",
            "example": "45021"
          },
          "exchangeSegment": {
            "type": "string",
            "description": "Exchange segment",
            "example": "NSE_FNO",
            "default": "NSE_FNO"
          },
          "transactionType": {
            "type": "string",
            "description": "BUY or SELL",
            "enum": [
              "BUY",
              "SELL"
            ],
            "example": "BUY"
          },
          "orderType": {
            "type": "string",
            "description": "Order type",
            "enum": [
              "MARKET",
              "LIMIT",
              "SL",
              "SL-M"
            ],
            "default": "MARKET"
          },
          "productType": {
            "type": "string",
            "description": "Product type",
            "enum": [
              "INTRADAY",
              "CNC",
              "MARGIN"
            ],
            "default": "INTRADAY"
          },
          "quantity": {
            "type": "number",
            "description": "Order quantity",
            "example": 50
          },
          "price": {
            "type": "number",
            "description": "Price for LIMIT orders",
            "example": 130
          },
          "triggerPrice": {
            "type": "number",
            "description": "Trigger price for SL orders",
            "example": 0
          }
        },
        "required": [
          "symbol",
          "securityId",
          "transactionType",
          "quantity"
        ]
      }
    }
  }
}