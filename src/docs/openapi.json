    "/api/instruments/option-contracts": {
      "get": {
        "description": "Accepts instrument name (e.g. NIFTY 50), optional reference price (e.g. 25500), and optional expiry date. Returns 3 strikes (At The Money, In The Money, Out of The Money) with live/model LTP for current and next expiry.",
        "operationId": "InstrumentsController_getOptionContractsGet",
        "parameters": [
          {
            "name": "instrument",
            "required": true,
            "in": "query",
            "description": "Underlying instrument name or symbol (e.g. NIFTY 50, NIFTY, BANKNIFTY, SENSEX)",
            "schema": {
              "example": "NIFTY 50",
              "type": "string"
            }
          },
          {
            "name": "price",
            "required": false,
            "in": "query",
            "description": "Reference price to calculate ATM, ITM, and OTM strikes (e.g. 25500). If omitted, live LTP is used.",
            "schema": {
              "example": 25500,
              "type": "number"
            }
          },
          {
            "name": "expiry",
            "required": false,
            "in": "query",
            "description": "Optional specific target expiry date in YYYY-MM-DD format",
            "schema": {
              "example": "2026-11-05",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Option contracts for current and next expiry with live/model LTP"
          },
          "400": {
            "description": "Instrument name missing or invalid"
          }
        },
        "summary": "Get 3 option contracts (ATM, ITM, OTM) for current and next expiry",
        "tags": [
          "Instruments"
        ]
      },
      "post": {
        "description": "JSON body alternative accepting instrument, optional price, and optional expiry date, returning ATM, ITM, and OTM contracts.",
        "operationId": "InstrumentsController_getOptionContractsPost",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetOptionContractsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Option contracts for current and next expiry with live/model LTP"
          },
          "400": {
            "description": "Instrument name missing or invalid"
          }
        },
        "summary": "Get 3 option contracts (ATM, ITM, OTM) for current and next expiry via POST payload",
        "tags": [
          "Instruments"
        ]
      }
    },
    "/api/instruments/ltp": {
